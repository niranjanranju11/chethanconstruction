# -----------------------------------------------------------------------------
# Chethan Construction — Root Environment Configuration Example
# Copy to .env or configure respective frontend/.env and backend environment variables.
# -----------------------------------------------------------------------------

# Backend Environment
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/chethan_construction
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password

# Security & JWT
# Key must be at least 256 bits (32+ characters)
JWT_SECRET=super-secret-jwt-signing-key-for-chethan-construction-min-256-bits
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Initial Admin Bootstrap Account
ADMIN_INITIAL_EMAIL=admin@chethanconstruction.com
ADMIN_INITIAL_PASSWORD=AdminPassword123!

# CORS & Frontend Origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8080

# Cloudflare R2 / S3 Compatible Object Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=chethan-construction-media
R2_REGION=auto
MEDIA_PUBLIC_BASE_URL=https://media.chethanconstruction.com

# Media Upload Limits (Bytes)
MAX_IMAGE_SIZE_BYTES=10485760
MAX_VIDEO_SIZE_BYTES=262144000

# Logging
LOG_LEVEL=INFO

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SITE_URL=http://localhost:5173
VITE_WHATSAPP_NUMBER=+919876543210
